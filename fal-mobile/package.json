{
  "name": "fal-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "build:preview": "eas build -p android --profile preview",
    "typecheck": "tsc --noEmit",
    "fix-deps": "expo install --fix",
    "build:web": "expo export --platform web --output-dir dist-web && node scripts/postexport.mjs dist-web",
    "build:web:local": "EXPO_PUBLIC_API_URL=http://127.0.0.1:8000 expo export --platform web --output-dir dist-web --clear && node scripts/postexport.mjs dist-web",
    "i18n:check": "node scripts/i18n-check.mjs",
    "yasal:check": "node scripts/yasal-check.mjs",
    "ci:check": "npm run config:check && npm run api:check && npm run typecheck && npm run art:check && npm run i18n:check && npm run bildirim:check && npm run yetenek:check",
    "security:check": "node scripts/security-check.mjs",
    "release:check": "npm run config:release && npm run ci:check && npm run security:check && npm run yasal:check && npm run build:web",
    "config:check": "node scripts/config-check.mjs",
    "config:release": "node scripts/config-check.mjs --release",
    "api:check": "node scripts/api-check.mjs",
    "bildirim:check": "node scripts/bildirim-check.mjs",
    "yetenek:check": "node scripts/yetenek-check.mjs",
    "art:check": "node scripts/art-check.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/jetbrains-mono": "^0.2.3",
    "@expo-google-fonts/karla": "^0.2.3",
    "@expo-google-fonts/newsreader": "^0.2.3",
    "@expo/metro-runtime": "~57.0.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "@tanstack/react-query": "^5.59.0",
    "expo": "~57.0.11",
    "expo-asset": "~57.0.9",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.9",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-image-manipulator": "~57.0.8",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.9",
    "expo-router": "~57.0.11",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.12",
    "posthog-react-native": "^3.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-applovin-max": "^9.6.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-purchases": "^8.2.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "expo-doctor": "^1.20.1",
    "typescript": "~5.8.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "private": true
}
