{
  "expo": {
    "name": "Telve",
    "slug": "telve",
    "scheme": "telve",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#16100E",
      "resizeMode": "contain",
      "image": "./assets/splash.png"
    },
    "android": {
      "package": "com.telve.app",
      "adaptiveIcon": { "backgroundColor": "#16100E", "foregroundImage": "./assets/icon.png" },
      "permissions": ["CAMERA", "POST_NOTIFICATIONS"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-camera", { "cameraPermission": "Fincan fotoğrafını çekmek için kameraya erişmemiz gerekiyor." }],
      ["expo-notifications", { "color": "#C87942" }],
      "expo-updates"
    ],
    "extra": { "apiUrl": "https://api.telve.app" },
    "updates": { "url": "https://u.expo.dev/PROJE_ID", "fallbackToCacheTimeout": 0 },
    "runtimeVersion": { "policy": "appVersion" }
  }
}
