# fal-backend — ortam değişkenleri
# Kopyala: cp .env.example .env

# --- Veri ---
DATABASE_URL=postgresql://localhost/fal
REDIS_URL=redis://localhost:6379/0

# --- LLM ---
LLM_API_KEY=
LLM_BASE_URL=https://api.anthropic.com/v1/messages
LLM_API_VERSION=2023-06-01

# Model kademesi. nano: guardrail / sembol etiketleme / hafıza özetleme,
# small: ücretsiz fal + blok birleştirme, large: ödeyen kullanıcı falı.
MODEL_NANO=claude-haiku-4-5
MODEL_SMALL=claude-haiku-4-5
MODEL_LARGE=claude-sonnet-5

# --- Embedding (anti-tekrar + semantic cache) ---
# Boş bırakılırsa llm.py yerel/deterministik yola düşer.
EMBED_URL=
EMBED_KEY=
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Ephemeris ---
# Boş bırakılırsa Swiss Ephemeris Moshier moduna düşer (~1 yay saniyesi hata,
# ürün için fazlasıyla yeterli). sepl_18.se1 + semo_18.se1 koyacaksan klasörü yaz.
SWE_EPHE_PATH=

# --- RevenueCat webhook ---
RC_WEBHOOK_SECRET=
